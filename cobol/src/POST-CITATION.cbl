>>SOURCE FORMAT FREE
*> Read citations.csv (citing,cited,year) and write a double-entry journal.
*> Citing paper is debited; cited paper is credited. One citation = 100 cents.
IDENTIFICATION DIVISION.
PROGRAM-ID. POST-CITATION.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CITE-FILE ASSIGN TO "citations.csv"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS CITE-STATUS.
    SELECT JOURNAL-FILE ASSIGN TO "journal.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS JRNL-STATUS.
    SELECT JOURNAL-CSV ASSIGN TO "journal.csv"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS CSV-STATUS.

DATA DIVISION.
FILE SECTION.
FD CITE-FILE.
01 CITE-LINE                 PIC X(128).

FD JOURNAL-FILE.
01 JOURNAL-LINE              PIC X(96).

FD JOURNAL-CSV.
01 CSV-LINE                  PIC X(160).

WORKING-STORAGE SECTION.
COPY JOURNAL.

01 CITE-STATUS               PIC XX VALUE "00".
01 JRNL-STATUS               PIC XX VALUE "00".
01 CSV-STATUS                PIC XX VALUE "00".
01 WS-EOF                    PIC X VALUE "N".
01 WS-HEADER-SKIP            PIC X VALUE "Y".
01 WS-JE                     PIC 9(8) VALUE 0.
01 WS-CITING                 PIC X(16).
01 WS-CITED                  PIC X(16).
01 WS-YEAR-X                 PIC X(8).
01 WS-YEAR                   PIC 9(4) VALUE 2020.
01 WS-DATE                   PIC 9(8).
01 WS-PTR                    PIC 99.
01 WS-FIELD                  PIC X(32).
01 WS-FCOUNT                 PIC 99.
01 WS-AMOUNT                 PIC 9(10) VALUE 100.
01 WS-MEMO                   PIC X(38) VALUE "citation debt".
01 WS-CSV-ID                 PIC 9(8).

PROCEDURE DIVISION.
MAIN-SECTION.
    OPEN INPUT CITE-FILE
    IF CITE-STATUS NOT = "00"
        DISPLAY "POST-CITATION: cannot open citations.csv status=" CITE-STATUS
        STOP RUN
    END-IF
    OPEN OUTPUT JOURNAL-FILE
    OPEN OUTPUT JOURNAL-CSV
    MOVE "je_id,date,debit_account,credit_account,amount_cents,memo"
        TO CSV-LINE
    WRITE CSV-LINE

    PERFORM UNTIL WS-EOF = "Y"
        READ CITE-FILE
            AT END
                MOVE "Y" TO WS-EOF
            NOT AT END
                PERFORM PARSE-AND-POST
        END-READ
    END-PERFORM

    CLOSE CITE-FILE
    CLOSE JOURNAL-FILE
    CLOSE JOURNAL-CSV
    DISPLAY "POST-CITATION: posted " WS-JE " entries"
    STOP RUN.

PARSE-AND-POST.
    IF WS-HEADER-SKIP = "Y"
        MOVE "N" TO WS-HEADER-SKIP
        EXIT PARAGRAPH
    END-IF
    IF CITE-LINE = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-CITING
    MOVE SPACES TO WS-CITED
    MOVE SPACES TO WS-YEAR-X
    MOVE 1 TO WS-PTR
    MOVE 0 TO WS-FCOUNT
    PERFORM SPLIT-CSV 3 TIMES
    IF WS-CITING = SPACES OR WS-CITED = SPACES
        EXIT PARAGRAPH
    END-IF
    IF WS-CITING = WS-CITED
        EXIT PARAGRAPH
    END-IF
    IF WS-YEAR-X = SPACES
        MOVE 2020 TO WS-YEAR
    ELSE
        MOVE FUNCTION NUMVAL(WS-YEAR-X) TO WS-YEAR
    END-IF
    COMPUTE WS-DATE = WS-YEAR * 10000 + 615
    ADD 1 TO WS-JE
    MOVE WS-JE TO JE-ID
    MOVE WS-DATE TO JE-DATE
    MOVE WS-CITING TO DEBIT-ACCT
    MOVE WS-CITED TO CREDIT-ACCT
    MOVE WS-AMOUNT TO AMOUNT-CENTS
    MOVE WS-MEMO TO MEMO
    MOVE JOURNAL-REC TO JOURNAL-LINE
    WRITE JOURNAL-LINE
    MOVE WS-JE TO WS-CSV-ID
    MOVE SPACES TO CSV-LINE
    STRING
        WS-CSV-ID DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        WS-DATE DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        FUNCTION TRIM(WS-CITING) DELIMITED BY SIZE
        "," DELIMITED BY SIZE
        FUNCTION TRIM(WS-CITED) DELIMITED BY SIZE
        ",100,citation debt" DELIMITED BY SIZE
        INTO CSV-LINE
    END-STRING
    WRITE CSV-LINE.

SPLIT-CSV.
    MOVE SPACES TO WS-FIELD
    UNSTRING CITE-LINE DELIMITED BY ","
        INTO WS-FIELD
        WITH POINTER WS-PTR
    END-UNSTRING
    ADD 1 TO WS-FCOUNT
    IF WS-FCOUNT = 1
        MOVE WS-FIELD TO WS-CITING
    END-IF
    IF WS-FCOUNT = 2
        MOVE WS-FIELD TO WS-CITED
    END-IF
    IF WS-FCOUNT = 3
        MOVE WS-FIELD TO WS-YEAR-X
    END-IF.
